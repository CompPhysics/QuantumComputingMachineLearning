\begin{MintedVerbatim}[commandchars=\\\{\},codes={\catcode`\$=3\catcode`\^=7\catcode`\_=8\relax}]
\PYG{k+kn}{import}\PYG{+w}{ }\PYG{n+nn}{pennylane}\PYG{+w}{ }\PYG{k}{as}\PYG{+w}{ }\PYG{n+nn}{qml}
\PYG{k+kn}{from}\PYG{+w}{ }\PYG{n+nn}{pennylane}\PYG{+w}{ }\PYG{k+kn}{import} \PYG{n}{numpy} \PYG{k}{as} \PYG{n}{np}
\PYG{c+c1}{\PYGZsh{} Define the number of qubits}
\PYG{n}{n\PYGZus{}qubits} \PYG{o}{=} \PYG{l+m+mi}{3}
\PYG{c+c1}{\PYGZsh{} Create a device using default.qubit}
\PYG{n}{dev} \PYG{o}{=} \PYG{n}{qml}\PYG{o}{.}\PYG{n}{device}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{default.qubit}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,} \PYG{n}{wires}\PYG{o}{=}\PYG{n}{n\PYGZus{}qubits}\PYG{p}{)}
\PYG{c+c1}{\PYGZsh{} Define the Quantum Fourier Transform as a Quantum Function}
\PYG{n+nd}{@qml}\PYG{o}{.}\PYG{n}{qnode}\PYG{p}{(}\PYG{n}{dev}\PYG{p}{)}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{qft\PYGZus{}circuit}\PYG{p}{(}\PYG{p}{)}\PYG{p}{:}
    \PYG{k}{for} \PYG{n}{j} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{n\PYGZus{}qubits}\PYG{p}{)}\PYG{p}{:}
        \PYG{c+c1}{\PYGZsh{} Apply the Hadamard gate to the j\PYGZhy{}th qubit}
        \PYG{n}{qml}\PYG{o}{.}\PYG{n}{Hadamard}\PYG{p}{(}\PYG{n}{wires}\PYG{o}{=}\PYG{n}{j}\PYG{p}{)}
        \PYG{c+c1}{\PYGZsh{} Apply controlled phase shifts}
        \PYG{k}{for} \PYG{n}{k} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{j} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{n}{n\PYGZus{}qubits}\PYG{p}{)}\PYG{p}{:}
            \PYG{n}{qml}\PYG{o}{.}\PYG{n}{ControlledPhaseShift}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{pi} \PYG{o}{/} \PYG{l+m+mi}{2} \PYG{o}{*}\PYG{o}{*} \PYG{p}{(}\PYG{n}{k} \PYG{o}{\PYGZhy{}} \PYG{n}{j}\PYG{p}{)}\PYG{p}{,} \PYG{n}{wires}\PYG{o}{=}\PYG{p}{[}\PYG{n}{k}\PYG{p}{,} \PYG{n}{j}\PYG{p}{]}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} PennyLane natively returns the state, but if you want measurement in computational basis:}
    \PYG{k}{return} \PYG{n}{qml}\PYG{o}{.}\PYG{n}{probs}\PYG{p}{(}\PYG{n}{wires}\PYG{o}{=}\PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{n\PYGZus{}qubits}\PYG{p}{)}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Execute the QFT circuit}
\PYG{n}{probabilities} \PYG{o}{=} \PYG{n}{qft\PYGZus{}circuit}\PYG{p}{(}\PYG{p}{)}
