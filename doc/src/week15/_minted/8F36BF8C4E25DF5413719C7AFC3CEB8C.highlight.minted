\begin{MintedVerbatim}[commandchars=\\\{\},codes={\catcode`\$=3\catcode`\^=7\catcode`\_=8\relax}]
\PYG{k+kn}{import}\PYG{+w}{ }\PYG{n+nn}{numpy}\PYG{+w}{ }\PYG{k}{as}\PYG{+w}{ }\PYG{n+nn}{np}

\PYG{c+c1}{\PYGZsh{} Set random seed for reproducibility}
\PYG{n}{np}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{seed}\PYG{p}{(}\PYG{l+m+mi}{42}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Number of samples per class}
\PYG{n}{N\PYGZus{}per} \PYG{o}{=} \PYG{l+m+mi}{50}

\PYG{c+c1}{\PYGZsh{} Define Gaussian cluster means and covariances for two classes}
\PYG{n}{mean\PYGZus{}good} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{p}{[}\PYG{l+m+mi}{80}\PYG{p}{,} \PYG{l+m+mf}{0.3}\PYG{p}{,} \PYG{l+m+mi}{45}\PYG{p}{]}\PYG{p}{)}   \PYG{c+c1}{\PYGZsh{} High income, low debt ratio, middle age}
\PYG{n}{cov\PYGZus{}good}  \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{diag}\PYG{p}{(}\PYG{p}{[}\PYG{l+m+mi}{50}\PYG{p}{,} \PYG{l+m+mf}{0.01}\PYG{p}{,} \PYG{l+m+mi}{20}\PYG{p}{]}\PYG{p}{)}   \PYG{c+c1}{\PYGZsh{} Some variation}

\PYG{n}{mean\PYGZus{}bad}  \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{p}{[}\PYG{l+m+mi}{40}\PYG{p}{,} \PYG{l+m+mf}{0.7}\PYG{p}{,} \PYG{l+m+mi}{30}\PYG{p}{]}\PYG{p}{)}   \PYG{c+c1}{\PYGZsh{} Low income, high debt ratio, younger}
\PYG{n}{cov\PYGZus{}bad}   \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{diag}\PYG{p}{(}\PYG{p}{[}\PYG{l+m+mi}{30}\PYG{p}{,} \PYG{l+m+mf}{0.02}\PYG{p}{,} \PYG{l+m+mi}{20}\PYG{p}{]}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Sample synthetic data from multivariate Gaussians}
\PYG{n}{good\PYGZus{}data} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{multivariate\PYGZus{}normal}\PYG{p}{(}\PYG{n}{mean\PYGZus{}good}\PYG{p}{,} \PYG{n}{cov\PYGZus{}good}\PYG{p}{,} \PYG{n}{size}\PYG{o}{=}\PYG{n}{N\PYGZus{}per}\PYG{p}{)}
\PYG{n}{bad\PYGZus{}data}  \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{multivariate\PYGZus{}normal}\PYG{p}{(}\PYG{n}{mean\PYGZus{}bad}\PYG{p}{,}  \PYG{n}{cov\PYGZus{}bad}\PYG{p}{,}  \PYG{n}{size}\PYG{o}{=}\PYG{n}{N\PYGZus{}per}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Combine data and create labels (1 = good credit, 0 = bad credit)}
\PYG{n}{data} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{vstack}\PYG{p}{(}\PYG{p}{[}\PYG{n}{good\PYGZus{}data}\PYG{p}{,} \PYG{n}{bad\PYGZus{}data}\PYG{p}{]}\PYG{p}{)}
\PYG{n}{labels} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{]}\PYG{o}{*}\PYG{n}{N\PYGZus{}per} \PYG{o}{+} \PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{o}{*}\PYG{n}{N\PYGZus{}per}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Clip unrealistic values (e.g. negative values or ratios \PYGZgt{}1)}
\PYG{n}{data}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,}\PYG{l+m+mi}{0}\PYG{p}{]} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{clip}\PYG{p}{(}\PYG{n}{data}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{p}{,} \PYG{l+m+mi}{20}\PYG{p}{,} \PYG{l+m+mi}{120}\PYG{p}{)}  \PYG{c+c1}{\PYGZsh{} Income [20k, 120k]}
\PYG{n}{data}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,}\PYG{l+m+mi}{1}\PYG{p}{]} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{clip}\PYG{p}{(}\PYG{n}{data}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,}\PYG{l+m+mi}{1}\PYG{p}{]}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{)}     \PYG{c+c1}{\PYGZsh{} Debt ratio [0, 1]}
\PYG{n}{data}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,}\PYG{l+m+mi}{2}\PYG{p}{]} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{clip}\PYG{p}{(}\PYG{n}{data}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,}\PYG{l+m+mi}{2}\PYG{p}{]}\PYG{p}{,} \PYG{l+m+mi}{18}\PYG{p}{,} \PYG{l+m+mi}{70}\PYG{p}{)}   \PYG{c+c1}{\PYGZsh{} Age [18, 70]}

\PYG{c+c1}{\PYGZsh{} Normalize and scale features for quantum encoding}
\PYG{c+c1}{\PYGZsh{} We scale to [0, pi] range to use as rotation angles}
\PYG{n}{income\PYGZus{}scaled} \PYG{o}{=} \PYG{p}{(}\PYG{n}{data}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,}\PYG{l+m+mi}{0}\PYG{p}{]} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{20}\PYG{p}{)} \PYG{o}{/} \PYG{l+m+mi}{100}      \PYG{c+c1}{\PYGZsh{} \PYGZti{}[0,1]}
\PYG{n}{debt\PYGZus{}scaled}   \PYG{o}{=} \PYG{n}{data}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,}\PYG{l+m+mi}{1}\PYG{p}{]}                  \PYG{c+c1}{\PYGZsh{} already [0,1]}
\PYG{n}{age\PYGZus{}scaled}    \PYG{o}{=} \PYG{p}{(}\PYG{n}{data}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,}\PYG{l+m+mi}{2}\PYG{p}{]} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{18}\PYG{p}{)} \PYG{o}{/} \PYG{l+m+mi}{52}       \PYG{c+c1}{\PYGZsh{} \PYGZti{}[0,1]}

\PYG{c+c1}{\PYGZsh{} Stack and multiply by pi for AngleEmbedding}
\PYG{n}{X} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{vstack}\PYG{p}{(}\PYG{p}{[}\PYG{n}{income\PYGZus{}scaled}\PYG{p}{,} \PYG{n}{debt\PYGZus{}scaled}\PYG{p}{,} \PYG{n}{age\PYGZus{}scaled}\PYG{p}{]}\PYG{p}{)}\PYG{o}{.}\PYG{n}{T} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{pi}

\PYG{c+c1}{\PYGZsh{} Split into train/test sets}
\PYG{k+kn}{from}\PYG{+w}{ }\PYG{n+nn}{sklearn}\PYG{n+nn}{.}\PYG{n+nn}{model\PYGZus{}selection}\PYG{+w}{ }\PYG{k+kn}{import} \PYG{n}{train\PYGZus{}test\PYGZus{}split}
\PYG{n}{X\PYGZus{}train}\PYG{p}{,} \PYG{n}{X\PYGZus{}test}\PYG{p}{,} \PYG{n}{y\PYGZus{}train}\PYG{p}{,} \PYG{n}{y\PYGZus{}test} \PYG{o}{=} \PYG{n}{train\PYGZus{}test\PYGZus{}split}\PYG{p}{(}
    \PYG{n}{X}\PYG{p}{,} \PYG{n}{labels}\PYG{p}{,} \PYG{n}{test\PYGZus{}size}\PYG{o}{=}\PYG{l+m+mf}{0.2}\PYG{p}{,} \PYG{n}{stratify}\PYG{o}{=}\PYG{n}{labels}\PYG{p}{,} \PYG{n}{random\PYGZus{}state}\PYG{o}{=}\PYG{l+m+mi}{42}
\PYG{p}{)}

\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{Training samples:}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,} \PYG{n}{X\PYGZus{}train}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{Test samples:}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,} \PYG{n}{X\PYGZus{}test}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{)}

