\begin{MintedVerbatim}[commandchars=\\\{\},codes={\catcode`\$=3\catcode`\^=7\catcode`\_=8\relax}]
\PYG{k+kn}{import}\PYG{+w}{ }\PYG{n+nn}{pennylane}\PYG{+w}{ }\PYG{k}{as}\PYG{+w}{ }\PYG{n+nn}{qml}
\PYG{k+kn}{from}\PYG{+w}{ }\PYG{n+nn}{pennylane}\PYG{+w}{ }\PYG{k+kn}{import} \PYG{n}{numpy} \PYG{k}{as} \PYG{n}{pnp}

\PYG{c+c1}{\PYGZsh{} Number of qubits = number of features}
\PYG{n}{num\PYGZus{}qubits} \PYG{o}{=} \PYG{l+m+mi}{3}
\PYG{n}{dev} \PYG{o}{=} \PYG{n}{qml}\PYG{o}{.}\PYG{n}{device}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{default.qubit}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{,} \PYG{n}{wires}\PYG{o}{=}\PYG{n}{num\PYGZus{}qubits}\PYG{p}{)}

\PYG{n+nd}{@qml}\PYG{o}{.}\PYG{n}{qnode}\PYG{p}{(}\PYG{n}{dev}\PYG{p}{)}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{kernel\PYGZus{}circuit}\PYG{p}{(}\PYG{n}{x1}\PYG{p}{,} \PYG{n}{x2}\PYG{p}{)}\PYG{p}{:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Quantum kernel circuit: encodes x1, then uncomputes x2.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{c+c1}{\PYGZsh{} Encode first sample}
    \PYG{n}{qml}\PYG{o}{.}\PYG{n}{templates}\PYG{o}{.}\PYG{n}{AngleEmbedding}\PYG{p}{(}\PYG{n}{features}\PYG{o}{=}\PYG{n}{x1}\PYG{p}{,} \PYG{n}{wires}\PYG{o}{=}\PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{num\PYGZus{}qubits}\PYG{p}{)}\PYG{p}{,} \PYG{n}{rotation}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{Y}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}
    \PYG{c+c1}{\PYGZsh{} Apply the inverse (adjoint) embedding of second sample}
    \PYG{n}{qml}\PYG{o}{.}\PYG{n}{adjoint}\PYG{p}{(}\PYG{n}{qml}\PYG{o}{.}\PYG{n}{templates}\PYG{o}{.}\PYG{n}{AngleEmbedding}\PYG{p}{)}\PYG{p}{(}\PYG{n}{features}\PYG{o}{=}\PYG{n}{x2}\PYG{p}{,} \PYG{n}{wires}\PYG{o}{=}\PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{num\PYGZus{}qubits}\PYG{p}{)}\PYG{p}{,} \PYG{n}{rotation}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{Y}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}
    \PYG{c+c1}{\PYGZsh{} Measure probability of |0...0\PYGZgt{} state}
    \PYG{k}{return} \PYG{n}{qml}\PYG{o}{.}\PYG{n}{probs}\PYG{p}{(}\PYG{n}{wires}\PYG{o}{=}\PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{num\PYGZus{}qubits}\PYG{p}{)}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Define kernel function: probability of all\PYGZhy{}zero outcome = state overlap fidelity}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{quantum\PYGZus{}kernel}\PYG{p}{(}\PYG{n}{x1}\PYG{p}{,} \PYG{n}{x2}\PYG{p}{)}\PYG{p}{:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Compute the quantum kernel (fidelity) between two vectors x1, x2.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{c+c1}{\PYGZsh{} circuit returns probability array; index 0 corresponds to state |000\PYGZgt{}}
    \PYG{k}{return} \PYG{n}{kernel\PYGZus{}circuit}\PYG{p}{(}\PYG{n}{x1}\PYG{p}{,} \PYG{n}{x2}\PYG{p}{)}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}

\PYG{c+c1}{\PYGZsh{} Test the kernel on two training samples}
\PYG{n}{k\PYGZus{}val} \PYG{o}{=} \PYG{n}{quantum\PYGZus{}kernel}\PYG{p}{(}\PYG{n}{X\PYGZus{}train}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{p}{,} \PYG{n}{X\PYGZus{}train}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{]}\PYG{p}{)}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{Kernel between first two training points:}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,} \PYG{n}{k\PYGZus{}val}\PYG{p}{)}
\PYG{c+c1}{\PYGZsh{} Should be 1.0 when comparing a vector with itself}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{Kernel of a point with itself:}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,} \PYG{n}{quantum\PYGZus{}kernel}\PYG{p}{(}\PYG{n}{X\PYGZus{}train}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{p}{,} \PYG{n}{X\PYGZus{}train}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{p}{)}\PYG{p}{)}

