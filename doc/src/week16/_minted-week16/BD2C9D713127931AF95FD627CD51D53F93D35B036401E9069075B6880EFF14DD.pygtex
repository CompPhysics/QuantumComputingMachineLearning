\PYG{c+c1}{\PYGZsh{} Load and binarize MNIST}
\PYG{k}{def} \PYG{n+nf}{load\PYGZus{}binarized\PYGZus{}mnist}\PYG{p}{(}\PYG{n}{n\PYGZus{}samples}\PYG{o}{=}\PYG{l+m+mi}{1000}\PYG{p}{):}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Downloading MNIST...\PYGZdq{}}\PYG{p}{)}
    \PYG{n}{mnist} \PYG{o}{=} \PYG{n}{fetch\PYGZus{}openml}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}mnist\PYGZus{}784\PYGZsq{}}\PYG{p}{,} \PYG{n}{version}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{)}
    \PYG{n}{X} \PYG{o}{=} \PYG{n}{mnist}\PYG{o}{.}\PYG{n}{data}\PYG{p}{[:}\PYG{n}{n\PYGZus{}samples}\PYG{p}{]}\PYG{o}{.}\PYG{n}{astype}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{float32}\PYG{p}{)} \PYG{o}{/} \PYG{l+m+mf}{255.0}
    \PYG{n}{X} \PYG{o}{=} \PYG{p}{(}\PYG{n}{X} \PYG{o}{\PYGZgt{}} \PYG{l+m+mf}{0.5}\PYG{p}{)}\PYG{o}{.}\PYG{n}{astype}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{float32}\PYG{p}{)}
    \PYG{k}{return} \PYG{n}{X}

\PYG{c+c1}{\PYGZsh{} Quantum device and number of hidden qubits}
\PYG{n}{n\PYGZus{}visible} \PYG{o}{=} \PYG{l+m+mi}{8}  \PYG{c+c1}{\PYGZsh{} We will use only 8 pixels for this toy example}
\PYG{n}{n\PYGZus{}hidden} \PYG{o}{=} \PYG{l+m+mi}{4}
\PYG{n}{dev} \PYG{o}{=} \PYG{n}{qml}\PYG{o}{.}\PYG{n}{device}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}default.qubit\PYGZdq{}}\PYG{p}{,} \PYG{n}{wires}\PYG{o}{=}\PYG{n}{n\PYGZus{}hidden}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Define quantum circuit as hidden layer}
\PYG{k}{def} \PYG{n+nf}{qrbm\PYGZus{}circuit}\PYG{p}{(}\PYG{n}{v}\PYG{p}{,} \PYG{n}{weights}\PYG{p}{):}
    \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{n\PYGZus{}hidden}\PYG{p}{):}
        \PYG{n}{qml}\PYG{o}{.}\PYG{n}{Hadamard}\PYG{p}{(}\PYG{n}{wires}\PYG{o}{=}\PYG{n}{i}\PYG{p}{)}
        \PYG{n}{qml}\PYG{o}{.}\PYG{n}{RZ}\PYG{p}{(}\PYG{n}{weights}\PYG{p}{[}\PYG{n}{i}\PYG{p}{],} \PYG{n}{wires}\PYG{o}{=}\PYG{n}{i}\PYG{p}{)}
    \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{n\PYGZus{}hidden} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{1}\PYG{p}{):}
        \PYG{n}{qml}\PYG{o}{.}\PYG{n}{CNOT}\PYG{p}{(}\PYG{n}{wires}\PYG{o}{=}\PYG{p}{[}\PYG{n}{i}\PYG{p}{,} \PYG{n}{i} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{p}{])}
    \PYG{k}{return} \PYG{p}{[}\PYG{n}{qml}\PYG{o}{.}\PYG{n}{expval}\PYG{p}{(}\PYG{n}{qml}\PYG{o}{.}\PYG{n}{PauliZ}\PYG{p}{(}\PYG{n}{i}\PYG{p}{))} \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{n\PYGZus{}hidden}\PYG{p}{)]}

\PYG{c+c1}{\PYGZsh{} QRBM class}
\PYG{k}{class} \PYG{n+nc}{QRBM}\PYG{p}{:}
    \PYG{k}{def} \PYG{n+nf+fm}{\PYGZus{}\PYGZus{}init\PYGZus{}\PYGZus{}}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{n\PYGZus{}visible}\PYG{p}{,} \PYG{n}{n\PYGZus{}hidden}\PYG{p}{,} \PYG{n}{lr}\PYG{o}{=}\PYG{l+m+mf}{0.1}\PYG{p}{):}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{n\PYGZus{}visible} \PYG{o}{=} \PYG{n}{n\PYGZus{}visible}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{n\PYGZus{}hidden} \PYG{o}{=} \PYG{n}{n\PYGZus{}hidden}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{weights} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{uniform}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{2} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{pi}\PYG{p}{,} \PYG{n}{n\PYGZus{}hidden}\PYG{p}{,} \PYG{n}{requires\PYGZus{}grad}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{visible\PYGZus{}bias} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{zeros}\PYG{p}{(}\PYG{n}{n\PYGZus{}visible}\PYG{p}{,} \PYG{n}{requires\PYGZus{}grad}\PYG{o}{=}\PYG{k+kc}{False}\PYG{p}{)}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{optimizer} \PYG{o}{=} \PYG{n}{qml}\PYG{o}{.}\PYG{n}{GradientDescentOptimizer}\PYG{p}{(}\PYG{n}{stepsize}\PYG{o}{=}\PYG{n}{lr}\PYG{p}{)}

    \PYG{k}{def} \PYG{n+nf}{reconstruct}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{v}\PYG{p}{):}
        \PYG{c+c1}{\PYGZsh{} Use quantum circuit to sample hidden state}
        \PYG{n}{h\PYGZus{}exp} \PYG{o}{=} \PYG{n}{hidden\PYGZus{}layer}\PYG{p}{(}\PYG{n}{v}\PYG{p}{,} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{weights}\PYG{p}{)}
        \PYG{n}{v\PYGZus{}recon} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{tanh}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{dot}\PYG{p}{(}\PYG{n}{h\PYGZus{}exp}\PYG{p}{,} \PYG{n}{np}\PYG{o}{.}\PYG{n}{random}\PYG{o}{.}\PYG{n}{randn}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{n\PYGZus{}hidden}\PYG{p}{,} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{n\PYGZus{}visible}\PYG{p}{))} \PYG{o}{+} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{visible\PYGZus{}bias}\PYG{p}{)}
        \PYG{k}{return} \PYG{p}{(}\PYG{n}{v\PYGZus{}recon} \PYG{o}{\PYGZgt{}} \PYG{l+m+mf}{0.5}\PYG{p}{)}\PYG{o}{.}\PYG{n}{astype}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{float32}\PYG{p}{)}

    \PYG{k}{def} \PYG{n+nf}{cost}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{v}\PYG{p}{):}
        \PYG{n}{recon} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{reconstruct}\PYG{p}{(}\PYG{n}{v}\PYG{p}{)}
        \PYG{k}{return} \PYG{n}{np}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{((}\PYG{n}{v} \PYG{o}{\PYGZhy{}} \PYG{n}{recon}\PYG{p}{)} \PYG{o}{**} \PYG{l+m+mi}{2}\PYG{p}{)}

    \PYG{k}{def} \PYG{n+nf}{train}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{data}\PYG{p}{,} \PYG{n}{epochs}\PYG{o}{=}\PYG{l+m+mi}{10}\PYG{p}{):}
        \PYG{k}{for} \PYG{n}{epoch} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{epochs}\PYG{p}{):}
            \PYG{n}{total\PYGZus{}cost} \PYG{o}{=} \PYG{l+m+mi}{0}
            \PYG{k}{for} \PYG{n}{v} \PYG{o+ow}{in} \PYG{n}{data}\PYG{p}{:}
                \PYG{n}{v} \PYG{o}{=} \PYG{n}{v}\PYG{p}{[:}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{n\PYGZus{}visible}\PYG{p}{]}
                \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{weights}\PYG{p}{,} \PYG{n}{cost\PYGZus{}val} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{optimizer}\PYG{o}{.}\PYG{n}{step\PYGZus{}and\PYGZus{}cost}\PYG{p}{(}\PYG{k}{lambda} \PYG{n}{w}\PYG{p}{:} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{cost}\PYG{p}{(}\PYG{n}{v}\PYG{p}{),} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{weights}\PYG{p}{)}
                \PYG{n}{total\PYGZus{}cost} \PYG{o}{+=} \PYG{n}{cost\PYGZus{}val}
            \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Epoch }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{epoch}\PYG{o}{+}\PYG{l+m+mi}{1}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{: Cost = }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{total\PYGZus{}cost}\PYG{+w}{ }\PYG{o}{/}\PYG{+w}{ }\PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{data}\PYG{p}{)}\PYG{l+s+si}{:}\PYG{l+s+s2}{.4f}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}
\PYG{c+c1}{\PYGZsh{} Load and reduce MNIST}
\PYG{n}{X} \PYG{o}{=} \PYG{n}{load\PYGZus{}binarized\PYGZus{}mnist}\PYG{p}{(}\PYG{n}{n\PYGZus{}samples}\PYG{o}{=}\PYG{l+m+mi}{500}\PYG{p}{)}
