    \PYG{k}{def} \PYG{n+nf}{gibbs\PYGZus{}sample}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{v\PYGZus{}start}\PYG{p}{,} \PYG{n}{k}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Perform k steps of Gibbs sampling starting from visible vector v\PYGZus{}start\PYGZdq{}\PYGZdq{}\PYGZdq{}}
